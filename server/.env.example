# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can provide a MongoDB Atlas URI or local connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/syncboard?retryWrites=true&w=majority
# If MONGO_URI is omitted or cannot be reached locally, SyncBoard automatically starts an in-memory MongoDB instance for seamless local testing.
MONGO_URI=mongodb://localhost:27017/syncboard

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRE=7d

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173
